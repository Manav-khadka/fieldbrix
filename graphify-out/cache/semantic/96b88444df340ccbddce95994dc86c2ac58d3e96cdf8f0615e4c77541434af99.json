{"nodes": [{"id": "docs_engineering_handbook", "label": "Fieldbrix Engineering Handbook", "file_type": "document", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_engineering_handbook_nestjs_stack", "label": "NestJS modular monolith backend stack", "file_type": "concept", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L330", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_engineering_handbook_prisma_orm", "label": "Prisma ORM (type-safe DB client)", "file_type": "concept", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L517", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_engineering_handbook_powersync_sync_engine", "label": "PowerSync offline sync engine", "file_type": "concept", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L179", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_engineering_handbook_flutter_mobile_stack", "label": "Flutter mobile stack (Riverpod + Drift)", "file_type": "concept", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L2191", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_engineering_handbook_solid_principles", "label": "SOLID/DRY/KISS/YAGNI code principles", "file_type": "rationale", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L706", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Universal code principles binding on all contributors: single responsibility via events instead of direct cross-domain service calls, open/closed via polymorphic providers instead of if/else dispatch, dependency inversion via infrastructure/ adapters so no domain service imports a concrete third-party client directly."}, {"id": "docs_engineering_handbook_tenant_isolation_jwt", "label": "tenantId-from-JWT-only rule", "file_type": "rationale", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L928", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "tenantId is NEVER accepted from request body, query param, or any client-controlled input -- it is extracted from the verified JWT only, and every Prisma query in a repository must include tenantId in its WHERE clause (Security Rule N1/N2), layered on top of database-level Row-Level Security as defense-in-depth."}, {"id": "docs_engineering_handbook_idempotency_key_pattern", "label": "Client-generated idempotencyKey pattern", "file_type": "rationale", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L1469", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "idempotencyKey is required on every mutation endpoint and generated on the client at the moment of user action, not at send time; replaying the same key returns the cached original result as a 409 that the client treats as success -- essential for offline-first mobile submissions that may retry after reconnecting."}, {"id": "docs_engineering_handbook_api_response_envelope", "label": "Uniform API response envelope", "file_type": "concept", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L1238", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_engineering_handbook_exception_hierarchy", "label": "DomainException hierarchy", "file_type": "concept", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L1493", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_engineering_handbook_audit_log_vs_operational_log", "label": "Audit log vs operational log separation", "file_type": "rationale", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L1764", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two separate systems: Winston/CloudWatch operational logs (engineering debug/alerting, 30-day retention, must not contain PII) versus the append-only hash-chained audit_logs table (business accountability/compliance, 6-8 year retention, contains entity diffs). Neither substitutes for the other; both are mandatory."}, {"id": "docs_engineering_handbook_turborepo_monorepo", "label": "Turborepo monorepo layout", "file_type": "concept", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L217", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_engineering_handbook_cost_summary", "label": "Complete infrastructure cost summary ($31.27/mo)", "file_type": "concept", "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L3023", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_engineering_handbook", "target": "docs_tech_implementation_guide", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L3200-L3202", "weight": 1.0}, {"source": "docs_engineering_handbook", "target": "docs_fieldbrix_schema_readme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L2736-L2738", "weight": 1.0}, {"source": "docs_engineering_handbook_tenant_isolation_jwt", "target": "docs_fieldbrix_schema_row_level_security", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ENGINEERING_HANDBOOK.md", "source_location": "L3017-L3019", "weight": 1.0}, {"source": "docs_engineering_handbook_audit_log_vs_operational_log", "target": "docs_fieldbrix_schema_audit_logs", "relation": "shares_data_with", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/ENGI