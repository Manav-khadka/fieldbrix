4", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fieldbrix_schema_import_jobs", "label": "import_jobs", "file_type": "code", "source_file": "docs/fieldbrix-schema.sql", "source_location": "L1035", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fieldbrix_schema_import_rows", "label": "import_rows", "file_type": "code", "source_file": "docs/fieldbrix-schema.sql", "source_location": "L1053", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fieldbrix_schema_notifications", "label": "notifications", "file_type": "code", "source_file": "docs/fieldbrix-schema.sql", "source_location": "L1068", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fieldbrix_schema_generated_reports", "label": "generated_reports", "file_type": "code", "source_file": "docs/fieldbrix-schema.sql", "source_location": "L1088", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fieldbrix_schema_audit_logs", "label": "audit_logs", "file_type": "code", "source_file": "docs/fieldbrix-schema.sql", "source_location": "L1108", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fieldbrix_schema_set_updated_at", "label": "set_updated_at() trigger function", "file_type": "code", "source_file": "docs/fieldbrix-schema.sql", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_fieldbrix_schema_row_level_security", "label": "Row-Level Security tenant isolation", "file_type": "rationale", "source_file": "docs/fieldbrix-schema.sql", "source_location": "L1154", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every tenant-scoped table gets ENABLE+FORCE ROW LEVEL SECURITY plus a tenant_isolation policy keyed off current_setting('app.tenant_id'). Defense-in-depth: even if application code forgets a WHERE tenant_id clause, Postgres itself refuses to return/write rows outside the session's tenant context. An unset app.tenant_id resolves to NULL via nullif(), matching nothing, so a transaction that forgets tenant context fails safely (zero rows) instead of leaking data."}, {"id": "docs_fieldbrix_schema_tenant_isolation_composite_fk", "label": "Composite (tenant_id, id) foreign key pattern", "file_type": "rationale", "source_file": "docs/fieldbrix-schema.sql", "source_location": "L36", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every multi-tenant table uses composite PK (tenant_id, id), and every FK carries tenant_id alongside the referenced id, so a row can never be joined/referenced across tenant boundaries even if application code forgets a WHERE tenant_id clause -- the foreign key itself enforces same-tenant linkage."}, {"id": "docs_fieldbrix_schema_uuidv7_primary_keys", "label": "UUIDv7 application-generated primary keys", "file_type": "rationale", "source_file": "docs/fieldbrix-schema.sql", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary keys are uuid, generated by the application as UUIDv7, which is time-ordered so it indexes/sorts almost as well as a sequence while remaining safe to generate client-side -- offline mobile clients can create IDs before ever reaching the server -- and safe to expose externally."}], "edges": [{"source": "docs_fieldbrix_schema_tenant_users", "target": "docs_fieldbrix_schema_tenants", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/fieldbrix-schema.sql", "source_location": null, "weight": 1.0}, {"source": "docs_fieldbrix_schema_tenant_users", "target": "docs_fieldbrix_schema_users", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/fieldbrix-schema.sql", "source_locat